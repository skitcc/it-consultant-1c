# Copy to .env and edit on GPU server 2. Scripts and compose read this file.
# INFERENCE_BACKEND in the app .env (server 1) is a separate switch.

VLLM_IMAGE=vllm/vllm-openai:latest
HF_HOME=/opt/hf-cache
GPU_ID=0
# HF_TOKEN=

# --- LLM (gpt-oss-120b, same family as Ollama gpt-oss:120b) ---
LLM_MODEL=openai/gpt-oss-120b
LLM_SERVED_NAME=llm
LLM_PORT=8001
LLM_GPU_UTIL=0.56
LLM_MAX_MODEL_LEN=8192
LLM_MAX_NUM_SEQS=4
# LLM_EXTRA_ARGS=--reasoning-parser openai_gptoss

# --- Rerank ---
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_SERVED_NAME=rerank
RERANK_PORT=8002
RERANK_GPU_UTIL=0.13
RERANK_MAX_MODEL_LEN=2048
RERANK_MAX_NUM_SEQS=32

# --- VLM ---
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_SERVED_NAME=vlm
VLM_PORT=8003
VLM_GPU_UTIL=0.13
VLM_MAX_MODEL_LEN=4096
VLM_MAX_NUM_SEQS=2

# --- Embeddings (keep on GPU; do not move to CPU) ---
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_SERVED_NAME=embed
EMBED_PORT=8004
EMBED_GPU_UTIL=0.06
EMBED_MAX_MODEL_LEN=2048
EMBED_MAX_NUM_SEQS=32

# --- Ollama diagnostics / before-benchmark (server 2 or remote HTTP) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b
EMBEDDING_MODEL=nomic-embed-text
RERANK_MODEL_OLLAMA=dengcao/Qwen3-Reranker-8B:Q8_0
VLM_MODEL_OLLAMA=qwen3-vl:8b
RAG_CANDIDATES=20
