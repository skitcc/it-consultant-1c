[Unit]
Description=IT Consultant Open WebUI Knowledge synchronizer
Documentation=file:///opt/it-consultant
After=network-online.target api-gateway.service
Wants=network-online.target
PartOf=it-consultant.target

[Service]
Type=simple
User=it-consultant
Group=it-consultant
WorkingDirectory=/opt/it-consultant
EnvironmentFile=-/etc/it-consultant/.env
ExecStart=/opt/it-consultant/.venv/bin/python -m knowledge_sync
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/it-consultant

[Install]
WantedBy=it-consultant.target
