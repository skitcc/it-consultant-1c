# Mounts the documents network share onto /var/lib/it-consultant/db.
# WATCH_PATH in .env stays /var/lib/it-consultant/db — do not change it.
#
# After deploy, edit What= (and credentials) to the real share, then:
#   sudo systemctl daemon-reload
#   sudo systemctl restart var-lib-it\\x2dconsultant-db.mount
#   sudo systemctl restart reindex
#
# Unit file on disk must be named (systemd-escape -p --suffix=mount):
#   var-lib-it\x2dconsultant-db.mount

[Unit]
Description=IT Consultant documents network share
Documentation=file:///opt/it-consultant
After=network-online.target
Wants=network-online.target

[Mount]
# CHANGE ME after deploy — UNC / NFS export from admin
What=//fileserver/it-consultant-docs
Where=/var/lib/it-consultant/db
Type=cifs
Options=credentials=/etc/it-consultant/docs-credentials,uid=it-consultant,gid=it-consultant,iocharset=utf8,file_mode=0644,dir_mode=0755,_netdev
TimeoutSec=60

[Install]
WantedBy=multi-user.target
