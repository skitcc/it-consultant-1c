EWS_SERVER=mail.company.ru
EWS_EMAIL=Assistant@company.ru
EWS_USERNAME=DOMAIN\Assistant
EWS_PASSWORD=change-me
EWS_AUTH=ntlm
EWS_VERIFY_SSL=true
EWS_STREAMING_TIMEOUT_MINUTES=30
EWS_SESSION_POOL_SIZE=2
EWS_IGNORE_OWN_MAIL=true
EWS_CATCHUP_MINUTES=30

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=300
# AI_SYSTEM_PROMPT=Ты IT-консультант...

RECONNECT_DELAY_SEC=5
LOG_LEVEL=INFO

WATCH_PATH=/var/lib/it-consultant/db
DEBOUNCE_SECONDS=1.0
