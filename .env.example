EWS_SERVER=mail.company.ru
EWS_EMAIL=Assistant@company.ru
EWS_USERNAME=DOMAIN\Assistant
EWS_PASSWORD=change-me
EWS_AUTH=ntlm
EWS_VERIFY_SSL=true
EWS_STREAMING_TIMEOUT_MINUTES=30
EWS_SESSION_POOL_SIZE=2
EWS_IGNORE_OWN_MAIL=true
EWS_CATCHUP_MINUTES=30

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=300
# AI_SYSTEM_PROMPT=Ты IT-консультант...

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SEC=120
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=docs
RAG_CANDIDATES=20
RAG_TOP_K=8
RAG_NEIGHBOR_WINDOW=1
# RAG_SCORE_THRESHOLD=0.3
RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
# RERANK_BASE_URL=http://127.0.0.1:11434
RERANK_TIMEOUT_SEC=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

RECONNECT_DELAY_SEC=5
LOG_LEVEL=INFO

WATCH_PATH=/var/lib/it-consultant/db
DEBOUNCE_SECONDS=1.0
# Comma-separated; with or without leading dot. Unknown types are skipped.
INDEX_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.csv,.pdf,.docx,.pptx,.xlsx,.xls,.html,.htm
