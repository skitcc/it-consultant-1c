EWS_SERVER=mail.company.ru
EWS_EMAIL=Assistant@company.ru
EWS_USERNAME=DOMAIN\Assistant
EWS_PASSWORD=change-me
EWS_AUTH=ntlm
EWS_VERIFY_SSL=true
EWS_STREAMING_TIMEOUT_MINUTES=30
EWS_SESSION_POOL_SIZE=2
EWS_IGNORE_OWN_MAIL=true
EWS_CATCHUP_MINUTES=30

# mail_gateway → API Gateway
API_GATEWAY_BASE_URL=http://127.0.0.1:8000/v1
API_GATEWAY_API_KEY=change-chat-key
API_GATEWAY_MODEL=it-consultant
API_GATEWAY_TIMEOUT_SEC=300

# API Gateway HTTP server and OWUI External Document Loader
API_GATEWAY_HOST=127.0.0.1
API_GATEWAY_PORT=8000
OWUI_LOADER_KEY=change-loader-key
MAX_UPLOAD_BYTES=104857600
DEFAULT_KNOWLEDGE_ID=main
DOCUMENT_REGISTRY_PATH=/var/lib/it-consultant/registry.sqlite3

# Standalone knowledge_sync → Open WebUI
OPEN_WEBUI_BASE_URL=http://127.0.0.1:3000
OPEN_WEBUI_KNOWLEDGE_ID=replace-with-knowledge-id
OPEN_WEBUI_SYNC_TOKEN=change-sync-token
KNOWLEDGE_SYNC_INTERVAL_SEC=10
KNOWLEDGE_DELETE_GRACE_SNAPSHOTS=3

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=300
# AI_SYSTEM_PROMPT=Ты IT-консультант...

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SEC=120
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=docs
RAG_CANDIDATES=20
RAG_TOP_K=8
RAG_NEIGHBOR_WINDOW=1
# RAG_SCORE_THRESHOLD=0.3
RERANK_ENABLED=true
RERANK_MODEL=dengcao/Qwen3-Reranker-8B:Q8_0
# RERANK_BASE_URL=http://127.0.0.1:11434
RERANK_TIMEOUT_SEC=60
# CHUNK_SIZE = max tokens for Docling HybridChunker (nomic-embed-text ~8192).
CHUNK_SIZE=512
# Picture description enrichment (VLM on the same OLLAMA_BASE_URL, not a page-wide VLM pipeline).
PICTURE_DESCRIPTION_ENABLED=true
VLM_MODEL=qwen3-vl:8b
VLM_TIMEOUT_SEC=90
PICTURE_AREA_THRESHOLD=0.02

RECONNECT_DELAY_SEC=5
LOG_LEVEL=INFO
INDEX_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.csv,.pdf,.docx,.pptx,.xlsx,.xls,.html,.htm
